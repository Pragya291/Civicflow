{
  "info": {
    "_postman_id": "mbmc-pothole-api-collection",
    "name": "MBMC Pothole Governance Portal APIs",
    "description": "API collection for testing the Smart Urban Governance Portal for Pothole Management in Mira-Bhayandar (MBMC).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mbmc.gov.in\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Citizen Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"aarav@example.com\",\n  \"mobile\": \"9821199887\",\n  \"password\": \"aarav123\",\n  \"role\": \"citizen\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Citizen Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@example.com\",\n  \"password\": \"citizen123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Complaints",
      "item": [
        {
          "name": "Submit Complaint (JSON)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Large pothole on Mira Road Station Flyover slope.\",\n  \"severity\": \"High\",\n  \"location_name\": \"Mira Road Station Flyover\",\n  \"latitude\": 19.2815,\n  \"longitude\": 72.8558\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints"]
            }
          }
        },
        {
          "name": "Get All Complaints",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints"]
            }
          }
        },
        {
          "name": "Filter by Status (Pending)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/complaints?status=Pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints"],
              "query": [{ "key": "status", "value": "Pending" }]
            }
          }
        },
        {
          "name": "Track Complaint by Reference ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/complaints/MBMC-PTH-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "MBMC-PTH-001"]
            }
          }
        },
        {
          "name": "Get Map Markers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/complaints/map",
              "host": ["{{baseUrl}}"],
              "path": ["api", "complaints", "map"]
            }
          }
        },
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/stats/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "dashboard"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Management",
      "item": [
        {
          "name": "Update Complaint Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Resolved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/complaints/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "complaints", "1", "status"]
            }
          }
        },
        {
          "name": "Assign Complaint to Department",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_id\": 1,\n  \"notes\": \"Asphalt patch and paver replacement dispatched to site.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/complaints/2/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "complaints", "2", "assign"]
            }
          }
        },
        {
          "name": "Get Departments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/departments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "departments"]
            }
          }
        },
        {
          "name": "Delete Complaint",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/complaints/7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "complaints", "7"]
            }
          }
        }
      ]
    }
  ]
}
